# LLM — exactly one successful generation per draft/revision; Gemini is fallback only
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MAX_PLAN_REVISIONS=5

# Application Environment & Logging
# Set to 'production' for live deployment; 'development' allows ephemeral dev secrets with warnings
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_API_URL=

# Security Credentials
# In production (APP_ENV=production), both JWT_SECRET and PAYLOAD_ENCRYPTION_KEY are strictly MANDATORY.
# Production must use stable, persistent secrets and never rely on ephemeral development fallbacks.
# JWT_SECRET: Strong secret key (min 32 bytes recommended) for HMAC-SHA256 user authentication tokens.
JWT_SECRET=
# PAYLOAD_ENCRYPTION_KEY: 32-byte base64-encoded key used for AES-256-GCM search session payload encryption.
# Generate key via: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PAYLOAD_ENCRYPTION_KEY=

# Database
# PostgreSQL connection string with pgvector extension available (required for migration 006)
DATABASE_URL=
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# External Intelligence & Providers
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# Flight Booking Provider (Duffel)
DUFFEL_MODE=test
DUFFEL_API_TOKEN=
DUFFEL_TEST_API_TOKEN=
DUFFEL_LIVE_API_TOKEN=
FLIGHT_PROVIDER=duffel
DUFFEL_API_TIMEOUT_SECONDS=30
DUFFEL_ORDER_TIMEOUT_SECONDS=150
INTEGRATION_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_TIMEOUT_SECONDS=30
PRESENTATION_MODE=true

# Webhooks intentionally disabled during local/development phase. Enable only after deployment.
WEBHOOKS_ENABLED=false
DUFFEL_SUPPLIER_TIMEOUT_MS=45000


# =========================
# HOTEL AGENT — DUAL PROVIDER
# =========================
LITEAPI_MODE=sandbox
LITEAPI_SANDBOX_API_KEY=
LITEAPI_PRODUCTION_API_KEY=
LITEAPI_TIMEOUT_SECONDS=30
# Sandbox: ACC_CREDIT_CARD simulates supplier payment. Production requires an enabled supplier payment path (WALLET/CREDIT/etc.).
LITEAPI_BOOK_PAYMENT_METHOD=ACC_CREDIT_CARD

HOTELBEDS_MODE=test
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_TIMEOUT_SECONDS=30
# Hotelbeds Booking API currently requires mTLS for availability/checkrate/booking. Leave blank until certificates are issued.
HOTELBEDS_CLIENT_CERT=
HOTELBEDS_CLIENT_KEY=
# Example: {"goa":"GOI","dubai":"DXB","london":"LON"}; use the exact Hotelbeds destination code for each city.
HOTELBEDS_DESTINATION_CODES_JSON={}
